# Skopiuj do .env (cp .env.example .env) i dostosuj wartości.
# Plik .env jest ignorowany przez git - nie commituj go.

# --- PostgreSQL (docker-compose) ---
POSTGRES_USER=keygate
POSTGRES_PASSWORD=keygate_dev_pass
POSTGRES_DB=keygate
POSTGRES_PORT=5432

# --- Backend ---
DATABASE_URL=postgresql+psycopg://keygate:keygate_dev_pass@localhost:5432/keygate
DATABASE_CONNECT_TIMEOUT=3
APP_NAME=KeyGate
APP_ENV=development
DEBUG=false

# --- Dane testowe (scripts/seed.py) ---
# Hasła muszą mieć min. 15 znaków (wariant 9).
# Hasło początkowe konta ADMIN - przy pierwszym logowaniu wymuszona zmiana.
ADMIN_INITIAL_PASSWORD=zmien-mnie-haslo-startowe-admina
# Wspólne hasło użytkowników testowych (Redaktor, Czytelnik).
SEED_USER_PASSWORD=testowe-haslo-uzytkownikow-seed
